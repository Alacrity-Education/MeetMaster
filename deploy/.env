# Docker image
IMAGE=ghcr.io/alacrity-education/meetmaster
TAG=latest

# Database
PG_DATABASE=meetmaster
PG_USER=meetmaster
PG_PASS=change-me

# OIDC / OAuth2
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_AUTH_URL=change-me
OIDC_TOKEN_URL=change-me
OIDC_USER_INFO_URL=change-me
OIDC_JWKS_URL=change-me

# JWT claim used as the user's display name
NAME_CLAIM=name

# Set to true when running behind a reverse proxy (caddy, nginx, etc.) to trust X-Forwarded-* headers
TRUST_PROXY_HEADERS=true

# Optional: URL of the logo shown in the top bar (leave empty for default icon)
ICON_URL=
# Optional: URL of the favicon (leave empty for browser default)
FAVICON_URL=
# Optional: Title shown in the browser tab and top bar (defaults to MeetMaster)
APP_TITLE=
