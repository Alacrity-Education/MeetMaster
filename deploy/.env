# Docker image
IMAGE=ghcr.io/your-org/meetmaster
TAG=latest

# Database
PG_DATABASE=meetmaster
PG_USER=meetmaster
PG_PASS=change-me

# OIDC / OAuth2
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_AUTH_URL=change-me
OIDC_TOKEN_URL=change-me
OIDC_USER_INFO_URL=change-me
OIDC_JWKS_URL=change-me

# JWT claim used as the user's display name
NAME_CLAIM=name

# Optional: URL of the logo shown in the top bar (leave empty for default icon)
ICON_URL=